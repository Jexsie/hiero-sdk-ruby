#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Regenerate sdk/lib/hiero/status.rb from the HAPI ResponseCodeEnum.
#
#   bin/generate_status
#
# The output is committed rather than derived at load, for the same reason the
# protobuf classes are: it keeps the generated surface reviewable, and it keeps
# `require "hiero"` from pulling in hiero-proto and therefore gRPC. The offline
# half of the SDK -- keys, mnemonics, identifiers, value types -- stays usable by
# wallet and address tooling that never opens a socket.
#

require "fileutils"

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(ROOT, "proto", "lib"))
require "hiero/proto"

OUT = File.join(ROOT, "sdk", "lib", "hiero", "status.rb")

codes = Proto::ResponseCodeEnum.descriptor.to_a.map { |name, number| [name.to_s, number] }
codes.sort_by! { |_, number| number }

invalid = codes.reject { |name, _| name.match?(/\A[A-Z][A-Z0-9_]*\z/) }
abort "cannot express as Ruby constants: #{invalid.inspect}" unless invalid.empty?

File.write(OUT, <<~RUBY_SOURCE)
  # frozen_string_literal: true
  #
  # Generated by bin/generate_status from the HAPI ResponseCodeEnum
  # (#{Hiero::Proto::HAPI_VERSION}). Do not edit.

  module Hiero
    # A response code from the network.
    #
    # Every code the protocol defines is a constant here and a singleton instance,
    # so statuses compare by identity and can be used in case/when and as Hash
    # keys. An unknown code -- one added to the protocol after this SDK was
    # generated -- is still returned, as an instance with a nil name, rather than
    # raising: a node that speaks a newer protocol should not break a client.
    class Status
      include Comparable

      attr_reader :code, :name

      # code => Status, for every code known at generation time.
      REGISTRY = {}

      def initialize(code, name)
        @code = code
        @name = name
        freeze
      end
      private_class_method :new

      class << self
        # @param code [Integer]
        # @return [Status] a registered status, or one representing an unknown code
        def from_code(code)
          REGISTRY.fetch(code) { allocate_unknown(code) }
        end
        alias [] from_code

        # @return [Array<Status>] every status this SDK knows about
        def all = REGISTRY.values

        def define(code, name)
          status = send(:new, code, name)
          REGISTRY[code] = status
          const_set(name, status)
          status
        end
        private :define

        def allocate_unknown(code) = send(:new, code, nil)
        private :allocate_unknown
      end

      # @return [Boolean] whether the transaction reached consensus and succeeded.
      #   Note that OK is not success: it means a node accepted the transaction for
      #   processing, which says nothing about the outcome.
      def success? = code == 22

      # @return [Boolean] whether this code was defined when the SDK was generated
      def known? = !name.nil?

      # name is a Symbol, so it has to be converted -- returning a non-String from
      # to_s makes Ruby silently fall back to the default object representation.
      def to_s = name ? name.to_s : "UNKNOWN_STATUS_\#{code}"
      def inspect = "#<Hiero::Status \#{self} (\#{code})>"

      def <=>(other) = other.is_a?(Status) ? code <=> other.code : nil
      def ==(other) = other.is_a?(Status) && other.code == code
      alias eql? ==
      def hash = [Status, code].hash

  #{codes.map { |name, number| "    define(#{number}, :#{name})" }.join("\n")}
    end
  end
RUBY_SOURCE

puts "==> Wrote #{codes.length} status codes to #{OUT.delete_prefix("#{ROOT}/")}"

#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Regenerate proto/lib/hiero/proto/** from the .proto sources in proto/hapi/.
#
#   bin/generate_protos
#
# Requires the grpc-tools gem, which bundles protoc and the Ruby gRPC plugin:
#
#   gem install grpc-tools
#
# The generated output is committed, so a regeneration should show up as a
# reviewable diff rather than as something that happens at install time.
#

require "fileutils"
require "open3"

ROOT      = File.expand_path("..", __dir__)
PROTO_DIR = File.join(ROOT, "proto")
SRC_DIR   = File.join(PROTO_DIR, "hapi")
LIB_DIR   = File.join(PROTO_DIR, "lib")
OUT_DIR   = File.join(LIB_DIR, "hiero", "proto")

# The top-level directories of the vendored proto tree. Each becomes a namespace
# under lib/hiero/proto/ and gets an entry file you can require on its own.
NAMESPACES = %w[block fees mirror platform sdk services streams].freeze

PROTOC = "grpc_tools_ruby_protoc"

def abort_with(message)
  warn "error: #{message}"
  exit 1
end

def banner(message)
  puts "==> #{message}"
end

# --- preflight ---------------------------------------------------------------

unless system("which #{PROTOC} > /dev/null 2>&1")
  abort_with "#{PROTOC} not found on PATH. Install it with: gem install grpc-tools"
end

abort_with "#{SRC_DIR} is missing. Run bin/sync_protos first." unless Dir.exist?(SRC_DIR)

sources = Dir.glob(File.join(SRC_DIR, "**", "*.proto")).sort
abort_with "no .proto files under #{SRC_DIR}. Run bin/sync_protos first." if sources.empty?

protoc_version = `#{PROTOC} --version`.strip
banner "Generating from #{sources.length} .proto files using #{protoc_version}"

# --- generate ----------------------------------------------------------------

# Wipe only the generated namespaces; version.rb and the entry files that are not
# regenerated live alongside them and must survive.
NAMESPACES.each { |ns| FileUtils.rm_rf(File.join(OUT_DIR, ns)) }
FileUtils.mkdir_p(OUT_DIR)

relative_sources = sources.map { |path| path.delete_prefix("#{SRC_DIR}/") }

args = [
  PROTOC,
  "--proto_path=#{SRC_DIR}",
  "--ruby_out=#{OUT_DIR}",
  "--grpc_out=#{OUT_DIR}",
  *relative_sources
]

_stdout, stderr, status = Open3.capture3(*args, chdir: SRC_DIR)
unless status.success?
  warn stderr
  abort_with "protoc failed with status #{status.exitstatus}"
end
warn stderr unless stderr.empty?

# --- namespace the requires --------------------------------------------------

# protoc derives both the output path and the require lines from each .proto's
# path relative to --proto_path, so it emits lib/hiero/proto/services/foo_pb.rb
# containing `require 'services/bar_pb'`. Left alone that would force
# lib/hiero/proto onto the load path, squatting top-level names like "services"
# for every gem in the process. Rewriting the requires to be fully qualified
# keeps everything under the hiero/proto/ prefix and the load path clean.
#
# Requires for google/protobuf/** are left alone: those resolve to the
# google-protobuf gem, not to anything we generate.
namespace_pattern = /\A(?<indent>\s*)require\s+(?<q>['"])(?<path>(?:#{NAMESPACES.join("|")})\/[^'"]+)\k<q>/

generated = NAMESPACES.flat_map { |ns| Dir.glob(File.join(OUT_DIR, ns, "**", "*.rb")) }.sort
rewritten = 0

generated.each do |file|
  original = File.read(file)
  updated = original.lines.map do |line|
    match = namespace_pattern.match(line)
    next line unless match

    rewritten += 1
    "#{match[:indent]}require #{match[:q]}hiero/proto/#{match[:path]}#{match[:q]}\n"
  end.join

  File.write(file, updated) unless updated == original
end

banner "Generated #{generated.length} Ruby files, rewrote #{rewritten} require lines"

# --- entry files -------------------------------------------------------------

def relative_requires(dir, out_dir)
  Dir.glob(File.join(dir, "**", "*.rb")).sort.map do |file|
    "hiero/proto/#{file.delete_prefix("#{out_dir}/").delete_suffix(".rb")}"
  end
end

HEADER = <<~HEADER
  # frozen_string_literal: true
  #
  # Generated by bin/generate_protos. Do not edit.
HEADER

NAMESPACES.each do |namespace|
  dir = File.join(OUT_DIR, namespace)
  next unless Dir.exist?(dir)

  requires = relative_requires(dir, OUT_DIR)
  File.write(
    File.join(OUT_DIR, "#{namespace}.rb"),
    "#{HEADER}\n#{requires.map { |r| %(require "#{r}"\n) }.join}"
  )
end

File.write(File.join(LIB_DIR, "hiero", "proto.rb"), <<~ENTRY)
  #{HEADER.chomp}
  #
  # Loads every vendored namespace. Requiring the whole HAPI takes on the order of
  # 35 ms warm, and only about 5 ms more than the subset a client SDK strictly
  # needs, so there is nothing to be gained by loading it piecemeal. Each namespace
  # also has its own entry file for callers who prefer to be explicit:
  #
  #   require "hiero/proto/services"

  require "hiero/proto/version"
  #{NAMESPACES.map { |ns| %(require "hiero/proto/#{ns}") }.join("\n")}
ENTRY

banner "Wrote entry files for #{NAMESPACES.length} namespaces: #{NAMESPACES.join(", ")}"

# --- record the pins ---------------------------------------------------------

hapi_tag   = File.read(File.join(PROTO_DIR, "HAPI_VERSION")).strip
mirror_tag = File.read(File.join(PROTO_DIR, "MIRROR_VERSION")).strip
version_rb = File.join(OUT_DIR, "version.rb")
source     = File.read(version_rb)

source = source
  .sub(/HAPI_VERSION\s+= ".*"/, %(HAPI_VERSION   = "#{hapi_tag}"))
  .sub(/MIRROR_VERSION\s+= ".*"/, %(MIRROR_VERSION = "#{mirror_tag}"))

File.write(version_rb, source)

banner "Pinned to HAPI #{hapi_tag} / mirror #{mirror_tag}"
banner "Done."
